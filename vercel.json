{
  "redirects": [
    {
      "source": "/(de|fr|es|pt|nl|it)",
      "destination": "/$1/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://linkscore-web.vercel.app/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://linkscore-web.vercel.app/blog/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://linkscore-web.vercel.app/_next/:path*"
    },
    {
      "source": "/blog-sitemap.xml",
      "destination": "https://linkscore-web.vercel.app/sitemap.xml"
    },
    {
      "source": "/ingest/static/:path(.*)",
      "destination": "https://eu-assets.i.posthog.com/static/:path(.*)"
    },
    {
      "source": "/ingest/:path(.*)",
      "destination": "https://eu.i.posthog.com/:path(.*)"
    },
    {
      "source": "/:slug.:ext(png|jpg|jpeg|webp|avif|svg|gif)",
      "destination": "https://linkscore-web.vercel.app/:slug.:ext"
    },
    {
      "source": "/plan/:id",
      "destination": "/api/plan?id=:id"
    },
    {
      "source": "/imprint",
      "destination": "/imprint.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies.html"
    },
    {
      "source": "/headline-analyzer",
      "destination": "/headline-analyzer.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/generate-plan.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/send-reminders", "schedule": "0 9 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/account",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "query", "key": "start" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
