{
  "redirects": [
    {
      "source": "/(de|fr|es|pt|nl|it)",
      "destination": "/$1/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://linkscore-web.vercel.app/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://linkscore-web.vercel.app/blog/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://linkscore-web.vercel.app/_next/:path*"
    },
    {
      "source": "/:slug.:ext(png|jpg|jpeg|webp|avif|svg|gif)",
      "destination": "https://linkscore-web.vercel.app/:slug.:ext"
    },
    {
      "source": "/plan/:id",
      "destination": "/api/plan?id=:id"
    },
    {
      "source": "/imprint",
      "destination": "/imprint.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/generate-plan.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
