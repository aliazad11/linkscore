{
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://linkscore-web.vercel.app/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://linkscore-web.vercel.app/blog/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://linkscore-web.vercel.app/_next/:path*"
    },
    {
      "source": "/:slug.png",
      "destination": "https://linkscore-web.vercel.app/:slug.png"
    },
    {
      "source": "/plan/:id",
      "destination": "/api/plan?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/generate-plan.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
